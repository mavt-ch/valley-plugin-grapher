{
  "icon": "icon.svg",
  "main": "runtime/index.js",
  "assets": "runtime/assets",
  "uiSlots": {
    "left_sidebar": "grapher.sidebar",
    "main_workspace": "grapher.graph"
  },
  "slotDefaults": {
    "left_sidebar": {
      "order": 95
    }
  },
  "provides": [
    {
      "id": "workspace.surface",
      "kind": "extension",
      "version": "1.0.0"
    },
    {
      "id": "metadataPanel.segment",
      "kind": "extension",
      "version": "1.0.0"
    },
    {
      "id": "workspace.details",
      "kind": "extension",
      "version": "1.0.0"
    }
  ],
  "locales": {
    "en": "runtime/locales/en.json",
    "de": "runtime/locales/de.json",
    "es": "runtime/locales/es.json",
    "fr": "runtime/locales/fr.json",
    "zh-CN": "runtime/locales/zh-CN.json"
  },
  "runtime": {
    "ui": "runtime/index.js",
    "backend": "runtime/backend.js",
    "wasm": [
      {
        "id": "plot",
        "path": "runtime/assets/plot.wasm",
        "sha256": "6c692cbdb1556237c73dfc9410cb39e9fb063d228c9d127696c14b1e8ec80cd1",
        "target": "ui",
        "memoryPagesMax": 512,
        "exports": [
          "plot_input",
          "plot_analyze",
          "plot_text",
          "plot_sample",
          "plot_samples",
          "plot_eval",
          "plot_space",
          "plot_markers"
        ]
      }
    ]
  },
  "permissions": {
    "storage": {
      "metadata": [
        "assets/icons/grapher-icon"
      ]
    }
  }
